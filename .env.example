# Copy to .env and fill in. `npm run keys` generates every key below.

# --- Server ---
PORT=4021
# Public URL of this server (Render URL in production). Used in 402 links and MCP replies.
PUBLIC_URL=http://localhost:4021

# --- Seller ---
# Where HSP payments land, and the only address allowed to write receipts.
SELLER_ADDRESS=
SELLER_PRIVATE_KEY=
MERCHANT_NAME=Risklayer

# --- Payments (HSP) ---
# local: HSP-compatible gateway mounted at /hsp-local (labelled "not HashKey" everywhere)
# hsp:   HashKey's Merchant API with the credentials from the merchant console
HSP_MODE=local
# hashkey-testnet (chain 133) during development, hashkey (chain 177) for the demo
PAYMENT_NETWORK=hashkey-testnet
# secp256k1 merchant key registered with HashKey (PEM file path, or inline PEM with \n)
MERCHANT_KEY_PATH=merchant_private_key.pem
MERCHANT_PRIVATE_KEY_PEM=
# From the HashKey merchant console (HSP_MODE=hsp). In local mode these are generated per run if empty.
HSP_APP_KEY=
HSP_APP_SECRET=
# Defaults: QA for hashkey-testnet, production for hashkey
HSP_BASE_URL=
# Payer endpoint. HashKey has not published this body yet; confirm before using HSP_MODE=hsp.
HSP_PAY_MANDATE_URL=
# Local gateway only: submits the EIP-3009 authorization on chain. Without it payments are simulated.
RELAYER_PRIVATE_KEY=
# Local gateway without a relayer: treat verified-but-not-broadcast payments as paid.
# Only for local runs with no money. Never set on a public server.
ALLOW_SIMULATED_PAYMENTS=0
# EIP-712 domain of USDC on HSK testnet, if it differs from the defaults
TESTNET_USDC_EIP712_NAME=
TESTNET_USDC_EIP712_VERSION=

# --- Receipts ---
# RisklayerReceipts on HSK mainnet. Leave empty to skip receipts.
RECEIPTS_ADDRESS=

# --- Market data ---
HSK_RPC_URL=https://mainnet.hsk.xyz
HSK_TESTNET_RPC_URL=https://testnet.hsk.xyz

# --- Policy (basis points, seconds) ---
POLICY_MAX_IMPACT_BPS=100
POLICY_HARD_IMPACT_BPS=1500
POLICY_MAX_TWAP_DEV_BPS=200
POLICY_MAX_ORACLE_DEV_BPS=300
POLICY_MAX_ORACLE_AGE_SEC=86400
POLICY_MAX_BLOCK_AGE_SEC=60
# Comma-separated addresses pay-gate always blocks. Operator-maintained, not a sanctions feed.
PAY_GATE_DENYLIST=

# --- Trading agent ---
SELLER_URL=http://localhost:4021
AGENT_PRIVATE_KEY=
AGENT_MAX_USD_PER_CALL=1
# 1 lets the dashboard run the agent through POST /v1/demo/agent. Each run pays for real checks
# when the agent wallet is funded; it never sends a swap.
DEMO_AGENT=0
# Optional shared secret for the demo agent. When set, the dashboard proxy must send it (web: DEMO_AGENT_TOKEN).
DEMO_AGENT_TOKEN=
DEMO_AGENT_MAX_RUNS_PER_HOUR=30

# --- Local development ---
# 1 adds unpaid mirrors at /dev/v1/<sku>. Never set in production.
DEV_BYPASS=0
ACTIVITY_LOG=
